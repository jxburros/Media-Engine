{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jxburros/Media-Engine/schemas/worker.schema.json",
  "title": "Media Worker 1.1 request schemas",
  "$defs": {
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "bundle_id": {
          "type": "string"
        },
        "bundle_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "family": {
          "const": "sdxl-base"
        },
        "pipeline": {
          "const": "text-to-image"
        },
        "components": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "role": {
                "enum": [
                  "unet",
                  "vae",
                  "text_encoder",
                  "text_encoder_2",
                  "tokenizer",
                  "tokenizer_2",
                  "scheduler"
                ]
              },
              "artifact_handle": {
                "type": "string"
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "tensor_format": {
                "enum": [
                  "safetensors",
                  "json"
                ]
              }
            },
            "required": [
              "role",
              "artifact_handle",
              "digest",
              "tensor_format"
            ]
          }
        },
        "configuration": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "artifact_handle": {
              "type": "string"
            },
            "files": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "required": [
            "artifact_handle",
            "files"
          ]
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string"
            },
            "revision": {
              "type": "string"
            },
            "license": {
              "type": "string"
            }
          },
          "required": []
        }
      },
      "required": [
        "schema_version",
        "bundle_id",
        "bundle_digest",
        "family",
        "pipeline",
        "components",
        "configuration",
        "source"
      ]
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "enum": [
            "media-worker/1.0",
            "media-worker/1.1"
          ]
        },
        "attempt_id": {
          "type": "string",
          "pattern": "^attempt_[A-Za-z0-9_-]{1,80}$"
        },
        "bundle_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "task": {
          "enum": [
            "text-to-image",
            "image-to-image"
          ]
        },
        "inputs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "prompt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 10000
            },
            "negative_prompt": {
              "type": "string",
              "maxLength": 10000
            },
            "image": {
              "type": "string",
              "pattern": "^input_[a-f0-9]{32}$",
              "description": "Opaque handle returned by POST /v1/inputs; required for image-to-image and forbidden otherwise"
            }
          },
          "required": [
            "prompt"
          ]
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 64,
              "maximum": 2048,
              "multipleOf": 8
            },
            "height": {
              "type": "integer",
              "minimum": 64,
              "maximum": 2048,
              "multipleOf": 8
            },
            "steps": {
              "type": "integer",
              "minimum": 1,
              "maximum": 150
            },
            "seed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "guidance": {
              "type": "number",
              "minimum": 0,
              "maximum": 30
            },
            "sampler": {
              "const": "euler"
            },
            "scheduler": {
              "const": "euler"
            },
            "strength": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1,
              "description": "image-to-image only; effective steps are floor(steps \u00d7 strength) and must be at least 1"
            }
          },
          "required": [
            "width",
            "height",
            "steps",
            "seed",
            "guidance",
            "sampler",
            "scheduler"
          ]
        }
      },
      "required": [
        "protocol",
        "attempt_id",
        "bundle_digest",
        "task",
        "inputs",
        "parameters"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "task": {
                "const": "image-to-image"
              }
            }
          },
          "then": {
            "properties": {
              "protocol": {
                "const": "media-worker/1.1"
              },
              "inputs": {
                "required": [
                  "prompt",
                  "image"
                ]
              },
              "parameters": {
                "required": [
                  "strength"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "inputs": {
                "not": {
                  "required": [
                    "image"
                  ]
                }
              },
              "parameters": {
                "not": {
                  "required": [
                    "strength"
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "load": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "enum": [
            "media-worker/1.0",
            "media-worker/1.1"
          ]
        },
        "bundle": {
          "$ref": "#/$defs/bundle"
        },
        "options": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "precision": {
              "enum": [
                "float16",
                "float32"
              ]
            },
            "attention": {
              "const": "sdpa"
            },
            "offload": {
              "const": "none"
            }
          },
          "required": [
            "precision",
            "attention",
            "offload"
          ]
        }
      },
      "required": [
        "protocol",
        "bundle",
        "options"
      ]
    },
    "unload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "enum": [
            "media-worker/1.0",
            "media-worker/1.1"
          ]
        }
      },
      "required": [
        "protocol"
      ]
    },
    "input_record": {
      "type": "object",
      "additionalProperties": false,
      "description": "Response of POST /v1/inputs and GET /v1/inputs/{input_id}",
      "properties": {
        "input_id": {
          "type": "string",
          "pattern": "^input_[a-f0-9]{32}$"
        },
        "session_id": {
          "type": "string"
        },
        "mime_type": {
          "const": "image/png"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "width": {
          "type": "integer",
          "minimum": 64,
          "maximum": 2048,
          "multipleOf": 8
        },
        "height": {
          "type": "integer",
          "minimum": 64,
          "maximum": 2048,
          "multipleOf": 8
        }
      },
      "required": [
        "input_id",
        "session_id",
        "mime_type",
        "size",
        "sha256",
        "width",
        "height"
      ]
    },
    "memory_estimate": {
      "type": "object",
      "description": "Returned by /v1/validate for a load body and recorded on a successful load operation",
      "properties": {
        "value_mb": {
          "type": [
            "integer",
            "null"
          ]
        },
        "source": {
          "type": "string"
        },
        "basis": {
          "type": "string"
        },
        "precision": {
          "enum": [
            "float16",
            "float32"
          ]
        },
        "device": {
          "type": "string"
        },
        "uncertainty": {
          "type": "string"
        },
        "roles": {
          "type": "object"
        }
      },
      "required": [
        "value_mb",
        "source",
        "uncertainty"
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/execution"
    },
    {
      "$ref": "#/$defs/load"
    },
    {
      "$ref": "#/$defs/unload"
    }
  ]
}
