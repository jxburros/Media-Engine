{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jxburros/Media-Engine/schemas/worker-1.2.schema.json",
  "title": "Media Worker 1.2 request and record schemas (1.0 and 1.1 shapes remain valid)",
  "$defs": {
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "bundle_id": {
          "type": "string"
        },
        "bundle_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "family": {
          "enum": [
            "sdxl-base",
            "esrgan"
          ]
        },
        "pipeline": {
          "enum": [
            "text-to-image",
            "upscale"
          ]
        },
        "components": {
          "type": "array",
          "minItems": 2,
          "maxItems": 7,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "role": {
                "enum": [
                  "unet",
                  "vae",
                  "text_encoder",
                  "text_encoder_2",
                  "tokenizer",
                  "tokenizer_2",
                  "scheduler",
                  "network",
                  "configuration"
                ]
              },
              "artifact_handle": {
                "type": "string"
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "tensor_format": {
                "enum": [
                  "safetensors",
                  "json"
                ]
              }
            },
            "required": [
              "role",
              "artifact_handle",
              "digest",
              "tensor_format"
            ]
          }
        },
        "configuration": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "artifact_handle": {
              "type": "string"
            },
            "files": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "required": [
            "artifact_handle",
            "files"
          ]
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string"
            },
            "revision": {
              "type": "string"
            },
            "license": {
              "type": "string"
            },
            "conversion": {
              "$ref": "#/$defs/conversion"
            }
          },
          "required": []
        },
        "format": {
          "enum": [
            "diffusers-safetensors",
            "single-file-safetensors"
          ],
          "description": "media-worker/1.2 only; absent means diffusers-safetensors"
        }
      },
      "required": [
        "schema_version",
        "bundle_id",
        "bundle_digest",
        "family",
        "pipeline",
        "components",
        "configuration",
        "source"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "family": {
                "const": "sdxl-base"
              }
            }
          },
          "then": {
            "properties": {
              "pipeline": {
                "const": "text-to-image"
              },
              "format": {
                "const": "diffusers-safetensors"
              },
              "components": {
                "minItems": 7,
                "maxItems": 7,
                "items": {
                  "properties": {
                    "role": {
                      "enum": [
                        "unet",
                        "vae",
                        "text_encoder",
                        "text_encoder_2",
                        "tokenizer",
                        "tokenizer_2",
                        "scheduler"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "family": {
                "const": "esrgan"
              }
            }
          },
          "then": {
            "required": [
              "format"
            ],
            "properties": {
              "pipeline": {
                "const": "upscale"
              },
              "format": {
                "const": "single-file-safetensors"
              },
              "source": {
                "not": {
                  "required": [
                    "conversion"
                  ]
                }
              },
              "components": {
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "properties": {
                    "role": {
                      "enum": [
                        "network",
                        "configuration"
                      ]
                    }
                  }
                }
              },
              "configuration": {
                "properties": {
                  "files": {
                    "minProperties": 2,
                    "maxProperties": 2,
                    "required": [
                      "config.json"
                    ],
                    "propertyNames": {
                      "pattern": "^[^/]+$"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "enum": [
            "media-worker/1.0",
            "media-worker/1.1",
            "media-worker/1.2"
          ]
        },
        "attempt_id": {
          "type": "string",
          "pattern": "^attempt_[A-Za-z0-9_-]{1,80}$"
        },
        "bundle_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "task": {
          "enum": [
            "text-to-image",
            "image-to-image",
            "upscale"
          ]
        },
        "inputs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "prompt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 10000
            },
            "negative_prompt": {
              "type": "string",
              "maxLength": 10000
            },
            "image": {
              "type": "string",
              "pattern": "^input_[a-f0-9]{32}$",
              "description": "Opaque handle returned by POST /v1/inputs; required for image-to-image and forbidden otherwise"
            }
          },
          "required": []
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 64,
              "maximum": 2048,
              "multipleOf": 8
            },
            "height": {
              "type": "integer",
              "minimum": 64,
              "maximum": 2048,
              "multipleOf": 8
            },
            "steps": {
              "type": "integer",
              "minimum": 1,
              "maximum": 150
            },
            "seed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "guidance": {
              "type": "number",
              "minimum": 0,
              "maximum": 30
            },
            "sampler": {
              "const": "euler"
            },
            "scheduler": {
              "const": "euler"
            },
            "strength": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1,
              "description": "image-to-image only; effective steps are floor(steps × strength) and must be at least 1"
            },
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4,
              "description": "media-worker/1.2 text-to-image only; outputs image, image_2 … image_N with seeds seed … seed+N−1"
            },
            "tile": {
              "enum": [
                0,
                256,
                512,
                1024
              ],
              "description": "upscale only; 0 = one whole-image tile"
            },
            "tile_overlap": {
              "type": "integer",
              "minimum": 0,
              "maximum": 64,
              "description": "upscale only; default 16"
            }
          },
          "required": [
            "width",
            "height"
          ]
        }
      },
      "required": [
        "protocol",
        "attempt_id",
        "bundle_digest",
        "task",
        "inputs",
        "parameters"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "task": {
                "const": "image-to-image"
              }
            }
          },
          "then": {
            "properties": {
              "protocol": {
                "enum": [
                  "media-worker/1.1",
                  "media-worker/1.2"
                ]
              },
              "inputs": {
                "required": [
                  "prompt",
                  "image"
                ]
              },
              "parameters": {
                "required": [
                  "width",
                  "height",
                  "steps",
                  "seed",
                  "guidance",
                  "sampler",
                  "scheduler",
                  "strength"
                ],
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "count"
                      ]
                    },
                    {
                      "required": [
                        "tile"
                      ]
                    },
                    {
                      "required": [
                        "tile_overlap"
                      ]
                    }
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "task": {
                "const": "text-to-image"
              }
            }
          },
          "then": {
            "properties": {
              "inputs": {
                "required": [
                  "prompt"
                ],
                "not": {
                  "required": [
                    "image"
                  ]
                }
              },
              "parameters": {
                "required": [
                  "width",
                  "height",
                  "steps",
                  "seed",
                  "guidance",
                  "sampler",
                  "scheduler"
                ],
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "strength"
                      ]
                    },
                    {
                      "required": [
                        "tile"
                      ]
                    },
                    {
                      "required": [
                        "tile_overlap"
                      ]
                    }
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "task": {
                "const": "upscale"
              }
            }
          },
          "then": {
            "properties": {
              "protocol": {
                "const": "media-worker/1.2"
              },
              "inputs": {
                "required": [
                  "image"
                ],
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "prompt"
                      ]
                    },
                    {
                      "required": [
                        "negative_prompt"
                      ]
                    }
                  ]
                }
              },
              "parameters": {
                "propertyNames": {
                  "enum": [
                    "width",
                    "height",
                    "tile",
                    "tile_overlap"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "parameters": {
                "required": [
                  "count"
                ]
              }
            },
            "required": [
              "parameters"
            ]
          },
          "then": {
            "properties": {
              "protocol": {
                "const": "media-worker/1.2"
              }
            }
          }
        }
      ]
    },
    "load": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "enum": [
            "media-worker/1.0",
            "media-worker/1.1",
            "media-worker/1.2"
          ]
        },
        "bundle": {
          "$ref": "#/$defs/bundle"
        },
        "options": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "precision": {
              "enum": [
                "float16",
                "float32",
                "auto"
              ],
              "description": "auto is media-worker/1.2 only and listed in capabilities.auto_options"
            },
            "attention": {
              "const": "sdpa"
            },
            "offload": {
              "const": "none"
            }
          },
          "required": [
            "precision",
            "attention",
            "offload"
          ]
        },
        "adapters": {
          "type": "array",
          "maxItems": 4,
          "description": "media-worker/1.1 only; LoRA adapters that become part of the loaded identity",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "adapter": {
                "$ref": "#/$defs/adapter"
              },
              "scale": {
                "type": "number",
                "minimum": 0,
                "maximum": 2
              }
            },
            "required": [
              "adapter",
              "scale"
            ]
          }
        },
        "authorized_fallbacks": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "cpu",
              "lower_precision"
            ]
          },
          "description": "media-worker/1.2 only"
        }
      },
      "required": [
        "protocol",
        "bundle",
        "options"
      ],
      "allOf": [
        {
          "if": {
            "anyOf": [
              {
                "required": [
                  "authorized_fallbacks"
                ]
              },
              {
                "properties": {
                  "options": {
                    "properties": {
                      "precision": {
                        "const": "auto"
                      }
                    }
                  }
                }
              }
            ]
          },
          "then": {
            "properties": {
              "protocol": {
                "const": "media-worker/1.2"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "protocol": {
                "enum": [
                  "media-worker/1.0",
                  "media-worker/1.1"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "bundle": {
                "properties": {
                  "family": {
                    "const": "sdxl-base"
                  },
                  "source": {
                    "not": {
                      "required": [
                        "conversion"
                      ]
                    }
                  }
                },
                "not": {
                  "required": [
                    "format"
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "unload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "enum": [
            "media-worker/1.0",
            "media-worker/1.1",
            "media-worker/1.2"
          ]
        }
      },
      "required": [
        "protocol"
      ]
    },
    "input_record": {
      "type": "object",
      "additionalProperties": false,
      "description": "Response of POST /v1/inputs and GET /v1/inputs/{input_id}",
      "properties": {
        "input_id": {
          "type": "string",
          "pattern": "^input_[a-f0-9]{32}$"
        },
        "session_id": {
          "type": "string"
        },
        "mime_type": {
          "const": "image/png"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "width": {
          "type": "integer",
          "minimum": 64,
          "maximum": 2048,
          "multipleOf": 8
        },
        "height": {
          "type": "integer",
          "minimum": 64,
          "maximum": 2048,
          "multipleOf": 8
        }
      },
      "required": [
        "input_id",
        "session_id",
        "mime_type",
        "size",
        "sha256",
        "width",
        "height"
      ]
    },
    "memory_estimate": {
      "type": "object",
      "description": "Returned by /v1/validate for a load body and recorded on a successful load operation",
      "properties": {
        "value_mb": {
          "type": [
            "integer",
            "null"
          ]
        },
        "source": {
          "type": "string"
        },
        "basis": {
          "type": "string"
        },
        "precision": {
          "enum": [
            "float16",
            "float32"
          ]
        },
        "device": {
          "type": "string"
        },
        "uncertainty": {
          "type": "string"
        },
        "roles": {
          "type": "object"
        },
        "activations_mb": {
          "type": "integer",
          "description": "esrgan: one largest-tile activation term"
        },
        "count": {
          "type": "object",
          "description": "1.2 sdxl-base: how count scales working memory"
        }
      },
      "required": [
        "value_mb",
        "source",
        "uncertainty"
      ]
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "adapter_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,80}$"
        },
        "artifact_handle": {
          "type": "string"
        },
        "files": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string"
            },
            "revision": {
              "type": "string"
            },
            "license": {
              "type": "string"
            }
          }
        }
      },
      "required": [
        "schema_version",
        "adapter_id",
        "artifact_handle",
        "files",
        "digest",
        "source"
      ]
    },
    "validate_adapters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "enum": [
            "media-worker/1.1",
            "media-worker/1.2"
          ]
        },
        "adapters": {
          "type": "array",
          "maxItems": 4,
          "description": "media-worker/1.1 only; LoRA adapters that become part of the loaded identity",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "adapter": {
                "$ref": "#/$defs/adapter"
              },
              "scale": {
                "type": "number",
                "minimum": 0,
                "maximum": 2
              }
            },
            "required": [
              "adapter",
              "scale"
            ]
          }
        }
      },
      "required": [
        "protocol",
        "adapters"
      ]
    },
    "conversion": {
      "type": "object",
      "additionalProperties": false,
      "description": "media-worker/1.2 bundle.source.conversion: the converted directory's conversion.json provenance; every field given must equal the file's",
      "properties": {
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reference_bundle_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "converter": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "media_engine": {
              "type": [
                "string",
                "null"
              ]
            },
            "diffusers": {
              "type": [
                "string",
                "null"
              ]
            },
            "torch": {
              "type": [
                "string",
                "null"
              ]
            },
            "safetensors": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "media_engine",
            "diffusers",
            "torch",
            "safetensors"
          ]
        },
        "mapped_keys": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "unet": {
              "type": "integer",
              "minimum": 0
            },
            "vae": {
              "type": "integer",
              "minimum": 0
            },
            "text_encoder": {
              "type": "integer",
              "minimum": 0
            },
            "text_encoder_2": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "unet",
            "vae",
            "text_encoder",
            "text_encoder_2"
          ]
        },
        "schema_version": {
          "const": 1
        },
        "precision": {
          "enum": [
            "preserved",
            "float16",
            "float32"
          ]
        },
        "unmapped_keys": {
          "type": "array",
          "maxItems": 0
        },
        "ignored_keys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "source_sha256",
        "reference_bundle_digest",
        "converter",
        "mapped_keys"
      ]
    },
    "output_record": {
      "type": "object",
      "description": "Snapshot outputs[] entry and output event data",
      "properties": {
        "output_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,31}$"
        },
        "mime_type": {
          "type": "string"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        },
        "frames": {
          "type": "integer"
        },
        "fps": {
          "type": "number"
        },
        "duration_seconds": {
          "type": "number"
        },
        "sample_rate": {
          "type": "integer"
        },
        "channels": {
          "type": "integer"
        }
      },
      "required": [
        "output_id",
        "mime_type",
        "size",
        "sha256"
      ]
    },
    "device_identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "device": {
          "type": "string"
        },
        "index": {
          "type": [
            "integer",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "total_memory_mb": {
          "type": [
            "integer",
            "null"
          ]
        },
        "host_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "host_id_source": {
          "enum": [
            "machine-id",
            "hostname",
            "fixture"
          ]
        },
        "pid": {
          "type": "integer"
        }
      },
      "required": [
        "device",
        "index",
        "name",
        "total_memory_mb",
        "host_id",
        "host_id_source",
        "pid"
      ]
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "option": {
          "enum": [
            "precision"
          ]
        },
        "requested": {
          "const": "auto"
        },
        "resolved": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "option",
        "requested",
        "resolved",
        "reason"
      ]
    },
    "applied_fallback": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fallback": {
          "enum": [
            "cpu",
            "lower_precision"
          ]
        },
        "reason": {
          "type": "string"
        },
        "device": {
          "type": "string"
        },
        "precision": {
          "enum": [
            "float16",
            "float32"
          ]
        }
      },
      "required": [
        "fallback",
        "reason",
        "device",
        "precision"
      ]
    },
    "esrgan_configuration": {
      "type": "object",
      "additionalProperties": false,
      "description": "config.json of an esrgan bundle",
      "properties": {
        "architecture": {
          "const": "rrdbnet"
        },
        "scale": {
          "enum": [
            2,
            4
          ]
        },
        "in_channels": {
